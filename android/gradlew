#!/bin/sh

#
# Copyright © 2015-2021 the original authors (Gradle wrapper, simplified).
#
#   Gradle start up script for POSIX, generated by Gradle.
#   Simplified for PadLink + bootstrap: when gradle/wrapper/gradle-wrapper.jar
#   is missing (it is intentionally not committed), this script downloads the
#   official Gradle 8.11.1 wrapper jar from GitHub before running Gradle.
#   See README.md「gradle-wrapper.jar 自举说明」.
#

# Attempt to set APP_HOME
PRG="$0"
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "`uname`" in
  CYGWIN* )         cygwin=true  ;;
  Darwin* )         darwin=true  ;;
  MINGW* )          msys=true    ;;
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# --- PadLink bootstrap: fetch gradle-wrapper.jar when missing ---
if [ ! -f "$CLASSPATH" ]; then
    echo "gradle-wrapper.jar 不存在，正在下载官方 Gradle 8.11.1 wrapper jar（首次构建需要联网）..."
    JAR_URL="https://raw.githubusercontent.com/gradle/gradle/v8.11.1/gradle/wrapper/gradle-wrapper.jar"
    mkdir -p "$APP_HOME/gradle/wrapper" 2>/dev/null || die "ERROR: 无法创建 gradle/wrapper 目录"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$JAR_URL" -o "$CLASSPATH" || die "ERROR: 下载失败 $JAR_URL（网络不可用？）"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$JAR_URL" -O "$CLASSPATH" || die "ERROR: 下载失败 $JAR_URL（网络不可用？）"
    else
        die "ERROR: gradle-wrapper.jar 缺失且本机没有 curl/wget，请手动下载：\n$JAR_URL\n放置到 gradle/wrapper/gradle-wrapper.jar"
    fi
    echo "已下载 gradle-wrapper.jar"
fi

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME 指向无效目录: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    command -v java >/dev/null 2>&1 || die "ERROR: JAVA_HOME 未设置且 PATH 中找不到 java（需要 JDK 17）"
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$darwin" = "false" -a "$nonstop" = "false" ] ; then
    MAX_FD_LIMIT=`ulimit -H -n`
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
            MAX_FD="$MAX_FD_LIMIT"
        fi
        ulimit -n $MAX_FD
        if [ $? -ne 0 ] ; then
            warn "无法设置最大文件描述符上限: $MAX_FD"
        fi
    else
        warn "无法查询最大文件描述符上限: $MAX_FD_LIMIT"
    fi
fi

# For Cygwin or MSYS, switch paths to Windows format before running java
if [ "$cygwin" = "true" -o "$msys" = "true" ] ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`
fi

# Collect all arguments for the java command
set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath \
    "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "$@"
